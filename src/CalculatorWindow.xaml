<Window x:Class="Calculator.CalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Engineering Calculator"
        Width="380" Height="560"
        MinWidth="340" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E2228"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ENCY-flavoured dark palette -->
        <SolidColorBrush x:Key="PanelBrush" Color="#FF262B33" />
        <SolidColorBrush x:Key="DisplayBrush" Color="#FF15181D" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFE6E9EF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF8A93A3" />
        <SolidColorBrush x:Key="KeyBrush" Color="#FF2E343E" />
        <SolidColorBrush x:Key="KeyHoverBrush" Color="#FF3A424F" />
        <SolidColorBrush x:Key="KeyPressBrush" Color="#FF454E5D" />
        <SolidColorBrush x:Key="FuncKeyBrush" Color="#FF2A3038" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2F9FE0" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF3FB0F0" />
        <SolidColorBrush x:Key="AccentPressBrush" Color="#FF2688C0" />

        <!-- Flat calculator key -->
        <Style x:Key="KeyBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource KeyBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource KeyHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource KeyPressBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Function keys: slightly darker, smaller font -->
        <Style x:Key="FuncKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="Background" Value="{StaticResource FuncKeyBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- Accent key: equals -->
        <Style x:Key="AccentKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Angle-unit toggle -->
        <Style x:Key="ToggleKey" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource FuncKeyBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource KeyHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Display -->
        <Border Grid.Row="0" Background="{StaticResource DisplayBrush}" CornerRadius="8" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="ExpressionText"
                           Text=""
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="14"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Height="20" />
                <TextBox x:Name="InputText"
                         Text=""
                         Background="Transparent"
                         Foreground="{StaticResource TextBrush}"
                         BorderThickness="0"
                         CaretBrush="{StaticResource AccentBrush}"
                         FontSize="30"
                         TextAlignment="Right"
                         MaxLines="1"
                         VerticalContentAlignment="Center"
                         KeyDown="InputText_KeyDown" />
            </StackPanel>
        </Border>

        <!-- Angle unit + hint -->
        <Grid Grid.Row="1" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Type an expression or use the keys"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <ToggleButton x:Name="DegButton" Grid.Column="1" Content="DEG" Width="52" Height="26"
                          Style="{StaticResource ToggleKey}" IsChecked="True" Click="Deg_Click" />
            <ToggleButton x:Name="RadButton" Grid.Column="2" Content="RAD" Width="52" Height="26"
                          Style="{StaticResource ToggleKey}" Click="Rad_Click" />
        </Grid>

        <!-- Keypad -->
        <UniformGrid Grid.Row="2" Rows="8" Columns="4" Margin="0,4,0,0">
            <!-- Row 1: scientific -->
            <Button Style="{StaticResource FuncKey}" Content="sin" Tag="sin(" Click="Func_Click" />
            <Button Style="{StaticResource FuncKey}" Content="cos" Tag="cos(" Click="Func_Click" />
            <Button Style="{StaticResource FuncKey}" Content="tan" Tag="tan(" Click="Func_Click" />
            <Button Style="{StaticResource FuncKey}" Content="x^y" Tag="^" Click="Insert_Click" />

            <!-- Row 2: scientific -->
            <Button Style="{StaticResource FuncKey}" Content="√" Tag="sqrt(" Click="Func_Click" />
            <Button Style="{StaticResource FuncKey}" Content="ln" Tag="ln(" Click="Func_Click" />
            <Button Style="{StaticResource FuncKey}" Content="log" Tag="log(" Click="Func_Click" />
            <Button Style="{StaticResource FuncKey}" Content="x²" Tag="^2" Click="Insert_Click" />

            <!-- Row 3: scientific / constants -->
            <Button Style="{StaticResource FuncKey}" Content="π" Tag="pi" Click="Insert_Click" />
            <Button Style="{StaticResource FuncKey}" Content="e" Tag="e" Click="Insert_Click" />
            <Button Style="{StaticResource FuncKey}" Content="n!" Tag="!" Click="Insert_Click" />
            <Button Style="{StaticResource FuncKey}" Content="%" Tag="%" Click="Insert_Click" />

            <!-- Row 4: control + brackets -->
            <Button Style="{StaticResource FuncKey}" Content="C" Click="Clear_Click" />
            <Button Style="{StaticResource FuncKey}" Content="(" Tag="(" Click="Insert_Click" />
            <Button Style="{StaticResource FuncKey}" Content=")" Tag=")" Click="Insert_Click" />
            <Button Style="{StaticResource FuncKey}" Content="⌫" Click="Backspace_Click" />

            <!-- Row 5 -->
            <Button Style="{StaticResource KeyBase}" Content="7" Tag="7" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="8" Tag="8" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="9" Tag="9" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="÷" Tag="/" Click="Insert_Click" />

            <!-- Row 6 -->
            <Button Style="{StaticResource KeyBase}" Content="4" Tag="4" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="5" Tag="5" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="6" Tag="6" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="×" Tag="*" Click="Insert_Click" />

            <!-- Row 7 grouped below via nested grid is avoided; keep 7x4 with 0 spanning done in code -->
            <Button Style="{StaticResource KeyBase}" Content="1" Tag="1" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="2" Tag="2" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="3" Tag="3" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="−" Tag="-" Click="Insert_Click" />

            <!-- Row 8 -->
            <Button Style="{StaticResource KeyBase}" Content="0" Tag="0" Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="." Tag="." Click="Insert_Click" />
            <Button Style="{StaticResource KeyBase}" Content="+" Tag="+" Click="Insert_Click" />
            <Button Style="{StaticResource AccentKey}" Content="=" Click="Equals_Click" />
        </UniformGrid>
    </Grid>
</Window>
