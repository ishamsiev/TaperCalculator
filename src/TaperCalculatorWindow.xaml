<Window x:Class="TaperCalculator.TaperCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taper Calculator"
        Width="440" Height="560"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E2228"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- ENCY-flavoured dark palette -->
        <SolidColorBrush x:Key="PanelBrush" Color="#FF262B33" />
        <SolidColorBrush x:Key="DisplayBrush" Color="#FF15181D" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFE6E9EF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF8A93A3" />
        <SolidColorBrush x:Key="FieldBrush" Color="#FF15181D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2F9FE0" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF3FB0F0" />
        <SolidColorBrush x:Key="AccentPressBrush" Color="#FF2688C0" />

        <!-- Section caption -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Input field -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Read-only output value -->
        <Style x:Key="Output" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="OutLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Solve button: subdued dark, matches ENCY panels; accent shows only on hover -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FF2E343E" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" BorderThickness="1" BorderBrush="#FF3A424F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3A424F" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF262B33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button (Clear): flatter, muted text -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" BorderThickness="1" BorderBrush="#FF3A424F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2E343E" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF262B33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab look -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="0,0,4,0" Padding="14,7">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Grid.RowSpan="2" Background="Transparent" BorderThickness="0">
            <!-- ==================== TAPER ==================== -->
            <TabItem Header="Taper / Cone">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Enter any three; leave one empty." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Text="Big diameter D" />
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TpBigD" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Text="Small diameter d" />
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TpSmallD" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}" Text="Length L" />
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TpLength" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}" Text="Half angle α°" />
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TpHalfAngle" Style="{StaticResource Field}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource AccentButton}" Content="Solve" Click="SolveTaper_Click" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Clear" Click="ClearTaper_Click" />
                    </Grid>
                    <Border Background="{StaticResource DisplayBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Big diameter D" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TpOutBigD" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Small diameter d" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TpOutSmallD" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Length L" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TpOutLength" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Half angle α°" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TpOutHalf" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Included angle°" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TpOutIncluded" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Taper ratio 1 :" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TpOutRatio" Style="{StaticResource Output}" Text="-" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ==================== TRIANGLE ==================== -->
            <TabItem Header="Right triangle">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Two sides, or one side and angle A (opposite a)." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Text="Leg a" />
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TrA" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Text="Leg b" />
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TrB" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}" Text="Hypotenuse c" />
                        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TrC" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}" Text="Angle A° (opp. a)" />
                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TrAngle" Style="{StaticResource Field}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource AccentButton}" Content="Solve" Click="SolveTriangle_Click" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Clear" Click="ClearTriangle_Click" />
                    </Grid>
                    <Border Background="{StaticResource DisplayBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Leg a" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TrOutA" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Leg b" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TrOutB" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Hypotenuse c" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TrOutC" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Angle A°" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TrOutAngA" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Angle B°" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TrOutAngB" Style="{StaticResource Output}" Text="-" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ==================== THREAD ==================== -->
            <TabItem Header="Metric thread">
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Text="Nominal diameter and pitch (mm). Empty pitch = coarse." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Text="Nominal Ø D (M)" />
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ThNominal" Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Text="Pitch P" />
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ThPitch" Style="{StaticResource Field}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource AccentButton}" Content="Solve" Click="SolveThread_Click" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Clear" Click="ClearThread_Click" />
                    </Grid>
                    <Border Background="{StaticResource DisplayBrush}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Pitch P" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ThOutPitch" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Height H = P·√3/2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ThOutH" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Pitch Ø d2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ThOutD2" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Minor Ø d1" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ThOutD1" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Thread depth h3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ThOutDepth" Style="{StaticResource Output}" Text="-" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource OutLabel}" Text="Tap drill Ø ≈" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ThOutDrill" Style="{StaticResource Output}" Text="-" />
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="" Foreground="#FFE06C6C" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
